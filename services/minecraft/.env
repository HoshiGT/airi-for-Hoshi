OPENAI_API_BASEURL=''
OPENAI_API_KEY=''
OPENAI_MODEL='deepseek-chat'
OPENAI_REASONING_MODEL='deepseek-reasoner'

# ==============================================================================
# Startup summary provider (optional)
# ==============================================================================
# On startup the bot condenses the tail of its previous session into a short
# paragraph of durable facts (base coordinates, standing requests, how the master
# likes to be addressed) and pins it into the system prompt, where conversation
# trimming cannot reach it.
#
# This is deliberately a SEPARATE, cheap provider from OPENAI_* above. If the brain
# is pointed at claude-code-brain, summarising through it would spend Claude
# subscription quota on housekeeping.
#
# Leave SUMMARY_API_BASEURL or SUMMARY_MODEL empty to turn the feature off entirely.
#
# SUMMARY_API_BASEURL='https://api.deepseek.com/v1/'
# SUMMARY_API_KEY=''
# SUMMARY_MODEL='deepseek-chat'

BOT_USERNAME=''
BOT_HOSTNAME=''
BOT_PORT=''
# # For all online accounts, un-comment the following line to toggle Microsoft authentication.
# # Link for authentication will popup when the bot starts.
# #
# # After signed in, according to [how Minecraft protocol was implemented](https://github.com/PrismarineJS/node-minecraft-protocol/blob/bf89f7e86526c54d8c43f555d8f6dfa4948fd2d9/src/client/microsoftAuth.js#L7-L16)
# # and also, [authentication flow implemented here](https://github.com/PrismarineJS/prismarine-auth/blob/1aef6e1387d94fca839f2811d17ac6659ae556b4/src/MicrosoftAuthFlow.js#L59-L69),
# # the token will be cached with [the cache IDs specified here](https://github.com/PrismarineJS/prismarine-auth/blob/1aef6e1387d94fca839f2811d17ac6659ae556b4/src/MicrosoftAuthFlow.js#L88-L93)
# # in split files:
# #
# # - ${hash}_live-cache.json
# # - ${hash}_mca-cache.json
# # - ${hash}_xbl-cache.json
# #
# # inside of the directory provided by [`minecraft-folder-path`](https://github.com/simonmeusel/minecraft-folder-path)
# #
# # Linux: ~/.minecraft
# # macOS: ~/Library/Application Support/minecraft
# # Windows: %appdata%/.minecraft
# #
# # where ${hash} is the sha1 hash of the username you signing in with (as Minecraft username).
# #
# BOT_AUTH='microsoft'
BOT_VERSION=''

# ==============================================================================
# Debug and Development Tools
# ==============================================================================
# SECURITY NOTICE:
# The MCP Server, Debug Server, and Prismarine Viewer endpoints are completely
# unauthenticated. Enabling these exposes your bot's internal state and
# capabilities to anyone who can reach the ports. This can lead to Remote
# Code Execution (RCE) and full compromise of the bot if exposed to the internet
# or untrusted local networks. Only enable these if you know what you are doing
# and ensure they are not externally accessible.
# ==============================================================================
ENABLE_MCP_SERVER=false
ENABLE_DEBUG_SERVER=false
ENABLE_MINECRAFT_VIEWER=false

# ==============================================================================
# Vision (the `look` tool)
# ==============================================================================
# Lets the bot render a first-person frame and send it to the model as an image.
# Nothing starts until the model calls `look` for the first time; that first call
# pays for a headless Chromium launch and chunk meshing, later ones are fast.
#
# Requires the Playwright Chromium build: `pnpm exec playwright install chromium`.
# The most recent frame is mirrored to `data/vision/latest.jpg` for debugging.
#
# The renderer serves the viewer bundle on 127.0.0.1:BOT_VISION_PORT. It carries
# the same security caveat as the endpoints above: it is unauthenticated, so keep
# it off untrusted networks.
#
# Frame size drives image token cost (roughly width*height/750 tokens per look).
ENABLE_BOT_VISION=true
BOT_VISION_PORT=3008
BOT_VISION_WIDTH=640
BOT_VISION_HEIGHT=400
BOT_VISION_VIEW_DISTANCE=4

# claude-code-brain runtime knobs. Copy to `.env` (gitignored) to persist them;
# the start/dev scripts load `.env` via `tsx --env-file-if-exists`. All optional.

# TCP port for the OpenAI-compatible bridge.
# CLAUDE_BRAIN_PORT=14515

# Reasoning effort passed to the Agent SDK: low | medium | high.
# CLAUDE_BRAIN_EFFORT=low

# Forward the model's thinking as `reasoning_content` (AIRI shows it collapsed).
# CLAUDE_BRAIN_FORWARD_THINKING=1

# Keep one SDK session per conversation and resume it (send only the new turn) so
# the replayed transcript hits the prompt cache. Set 0 to force the stateless
# full-replay path.
# CLAUDE_BRAIN_SESSIONS=1

# Cap history replay to the last N user rounds on the FRESH path only — the path
# tool-use turns and cache misses take, which otherwise re-sends the entire
# transcript at cache-create (1.25x) price every time. Resume turns are
# unaffected and keep the full conversation server-side. Unset/0 = replay
# everything (the original behavior). A small integer (e.g. 8) bounds the cost of
# desktop-control / any tool-heavy turn.
# CLAUDE_BRAIN_MAX_HISTORY=8
